{
  "name": "workshop-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "prisma migrate deploy && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "db:up": "powershell -File scripts/start-postgres.ps1",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:core": "tsx prisma/seed-core.ts",
    "db:seed:domain": "tsx prisma/seeds/run-domain.ts",
    "db:seed:domain:facade": "tsx prisma/seeds/run-domain-facade.ts",
    "db:seed:domain:bakery": "tsx prisma/seeds/run-domain-bakery.ts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:seed:demo:facade": "tsx prisma/seed-demo.ts",
    "db:reset": "prisma migrate reset --force",
    "db:backup": "tsx scripts/backup-production.ts",
    "db:restore": "tsx scripts/restore-verify.ts",
    "db:restore:verify": "tsx scripts/restore-verify.ts",
    "validate:workshop": "tsx scripts/validate-workshop-setup.ts",
    "domain:scaffold": "tsx scripts/scaffold-domain.ts",
    "test": "tsx --test tests/costing.test.ts tests/tz-rules.test.ts tests/nav.test.ts tests/back-nav.test.ts tests/env-guard.test.ts tests/login-guard.test.ts tests/domain-config.test.ts tests/domain-registry.test.ts tests/seed-orchestrator.test.ts tests/production-order.test.ts tests/i18n-domain.test.ts tests/scaffold-domain.test.ts tests/finished-goods.test.ts tests/batch-auth.test.ts tests/role-matrix.test.ts tests/production-safety.test.ts tests/bakery-clone.test.ts tests/architecture-boundaries.test.ts tests/seed-settings-demo.test.ts tests/workshop-setup.test.ts tests/facade-catalog.test.ts",
    "e2e": "tsx scripts/e2e-full-chain.ts",
    "test:integration": "tsx --test tests/integration/*.integration.test.ts",
    "smoke:tz76": "tsx scripts/smoke-tz76.ts",
    "smoke:http": "tsx scripts/smoke-http.ts",
    "db:backup-daily": "powershell -File scripts/register-daily-backup.ps1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "decimal.js": "^10.6.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "postcss": "^8.5.26",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "@next/swc-win32-x64-msvc": "^16.3.0"
  }
}
