# === DATABASE ===
DATABASE_URL="postgresql://workshop:workshop@localhost:5432/workshop?schema=public"
# Direct (non-pooled) URL for Prisma migrations. Locally same as DATABASE_URL.
DIRECT_URL="postgresql://workshop:workshop@localhost:5432/workshop?schema=public"
# Connection pool size (default: 5)
DB_POOL_SIZE="5"

# === AUTH ===
AUTH_SECRET="replace-with-random-32-chars-minimum"
AUTH_URL="http://localhost:3000"
OWNER_EMAIL="owner@workshop.local"
# REQUIRED in production. Must NOT be the demo default.
OWNER_PASSWORD="ChangeMeNow!"
# Phone for owner login (digits or +992…). REQUIRED in production.
OWNER_PHONE="900000001"
# Auth bypass for local dev only. FORBIDDEN in production.
AUTH_BYPASS="0"

# === APPLICATION ===
# Standalone clone id (not multi-tenant). Registered: facade | bakery. See docs/clone.md
WORKSHOP_DOMAIN="facade"
# Include demo users/history in seed (set to 0 for production)
SEED_DEMO="1"
NODE_ENV="development"

# === LOGGING ===
# Log level: debug | info | warn | error (default: info in prod, debug in dev)
LOG_LEVEL="info"

# === BACKUP ===
# Override DATABASE_URL for backup operations (optional)
# BACKUP_DATABASE_URL=""
# Directory for local backup files (default: .data/backups)
# BACKUP_DIR=""
# Alias for BACKUP_DIR
# BACKUP_DESTINATION=""
# Days to retain old backups (default: 14)
BACKUP_RETENTION_DAYS="14"
# Off-site command. {FILE} = full path, {FILENAME} = basename.
# Example: aws s3 cp {FILE} s3://my-bucket/workshop-backups/{FILENAME}
# BACKUP_OFFSITE_CMD=""
# Optional explicit path to pg_dump binary
# BACKUP_PG_DUMP_PATH="C:\\Program Files\\PostgreSQL\\16\\bin\\pg_dump.exe"

# === RESTORE (verification only, NEVER production DB) ===
# RESTORE_DATABASE_URL="postgresql://user:pass@host:5432/workshop_verify"
# Optional explicit paths to restore binaries
# RESTORE_PSQL_PATH="C:\\Program Files\\PostgreSQL\\16\\bin\\psql.exe"
# RESTORE_PG_RESTORE_PATH="C:\\Program Files\\PostgreSQL\\16\\bin\\pg_restore.exe"
