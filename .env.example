DATABASE_URL="postgresql://workshop:workshop@localhost:5433/workshop?schema=public"
# Direct (non-pooled) URL for Prisma migrations. Locally same as DATABASE_URL.
# On Vercel/Neon: pooled host has `-pooler`, DIRECT_URL is the unpooled host.
DIRECT_URL="postgresql://workshop:workshop@localhost:5433/workshop?schema=public"
AUTH_SECRET="replace-with-random-32-chars-minimum"
AUTH_URL="http://localhost:3000"
OWNER_EMAIL="owner@workshop.local"
OWNER_PASSWORD="ChangeMeNow!"
# Локальный тест без формы входа (автоматически owner). Не включать в production.
# Внимание: при AUTH_BYPASS=1 переключение ролей на /login не работает — всегда owner.
# Production checklist: переменной AUTH_BYPASS в prod-окружении быть не должно.
AUTH_BYPASS="0"
# Standalone clone domain preset (not multi-tenancy). Default: facade
WORKSHOP_DOMAIN="facade"
